[Unit]
Description=ai-pc-agent debug API + dashboard (docs/api.html section 8)
After=network.target ai-pc-mi300-tunnel.service
Wants=ai-pc-mi300-tunnel.service

[Service]
Type=simple
User=wildbot
WorkingDirectory=/home/wildbot/2026-Meichu-Hackthon/ai-pc-agent
ExecStart=/home/wildbot/2026-Meichu-Hackthon/ai-pc-agent/.venv/bin/python -m uvicorn debug_api:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
